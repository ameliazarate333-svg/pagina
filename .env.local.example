# ============================================================
#  Variables de entorno de AZ · Amelia Zárate
#  Copia este archivo como  .env.local  y rellena los valores
#  desde tu panel de Supabase:  Project Settings → API
#  (NUNCA subas .env.local a GitHub — ya está en .gitignore)
# ============================================================

# URL de tu proyecto Supabase (ej: https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (es segura para el navegador; la protección real
# la dan las políticas RLS en la base de datos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
